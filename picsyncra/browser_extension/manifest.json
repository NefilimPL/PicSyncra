{
  "manifest_version": 3,
  "name": "PicSyncra Image Import",
  "version": "0.1.0",
  "description": "Collects product images from the current page and sends them to PicSyncra Web.",
  "action": {
    "default_title": "PicSyncra",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
